#!/bin/sh
# Regression tests for tribe-control's devlist layer.
#
# Runs on the bench host, because that is where the gems are: the tool
# needs exsys, which is not installed on the workstation, so a suite that
# imports it cannot run here.  Everything tested below is decided during
# devlist parsing, which happens BEFORE the hub object is constructed, so
# the tests that only parse a devlist never reach the hub at all.
#
# Nothing here writes flash or switches a port off.  One test does reset
# a board (see the positive control below), and the connect and flash
# tests power the ports of the boards they name UP, which is the benign
# direction and what those commands do anyway.
#
# What it covers, and why each is here: every one of these was a live
# defect fixed on 2026-09-16, and none of them had a test.
#
#   missing port      an entry with no port used to make 'usb off' raise
#                     KeyError and take every power-down with it
#   duplicate port    a reassigned port left on the old entry addressed
#                     one board under the other's interface and baud
#   port = none       a retired entry must be invisible to selection but
#                     still nameable, with an error that says which
#   quoted port       port = '8' loaded, counted as present, then made
#                     the whole tool unusable with "port out of range"
#   falsey key        attribute() returned its default for a key set to
#                     false, so 'port = none' read as present
#   flash/reset exit  each_device ran its jobs in forked processes, so the
#                     parent's accumulator stayed empty, [].all? was true,
#                     and both commands exited 0 however many boards had
#                     failed.  reset from the day it was written
#   no board          a declared port with nothing on it gave usb_to_tty
#                     nil, which reached a reader thread that died
#                     unjoined: the run went its full duration and
#                     reported ok=0, tx-rate=NaN, which reads exactly like
#                     a board that is up and silent
#
# Usage: sh test-tribe-control [host] [tribe-control-path]
#
# The second argument exists so the suite can be pointed at a deliberately
# broken copy: a test that has never been seen to fail is not evidence.
set -e
host=${1:-134.214.146.186}
tc=${2:-/root/tribe-control/bin/tribe-control}
dl=/root/devlist.conf
fail=0

check () {  # check <name> <expected-substring> <devlist-file>
    got=$(ssh -o BatchMode=yes "root@$host" "$tc -D $3 usb status 2>&1" || true)
    if printf '%s' "$got" | grep -qF "$2"; then
        echo "ok    $1"
    else
        echo "FAIL  $1"
        echo "      wanted: $2"
        echo "      got:    $(printf '%s' "$got" | tail -1)"
        fail=$((fail + 1))
    fi
}

ssh -o BatchMode=yes "root@$host" "
  sed 's/^  port        = none/  port        = 8/'      $dl > /tmp/t-dup.conf
  sed 's/^  port        = none//'                       $dl > /tmp/t-noport.conf
  sed \"s/^  port        = 8\\$/  port        = '8'/\"   $dl > /tmp/t-quoted.conf
"

check "good devlist names port 8"      " 8  DB" "$dl"
check "duplicate port refused"         "assigns the same port more than once" /tmp/t-dup.conf
check "missing port refused"           "has no port"                          /tmp/t-noport.conf
check "quoted port normalised"         " 8  DB"                               /tmp/t-quoted.conf

say () {  # say <name> <expected-substring> <command...>
    got=$(ssh -o BatchMode=yes "root@$host" "$3 2>&1" || true)
    if printf '%s' "$got" | grep -qF "$2"; then
        echo "ok    $1"
    else
        echo "FAIL  $1"
        echo "      wanted: $2"
        echo "      got:    $(printf '%s' "$got" | tail -1)"
        fail=$((fail + 1))
    fi
}

status () {  # status <name> <expected-exit> <command...>
    # && / || rather than $?: set -e is on, and a deliberately failing
    # command would otherwise take the suite down before rc is read.
    ssh -o BatchMode=yes "root@$host" "$3 >/dev/null 2>&1" && rc=0 || rc=$?
    if [ "$rc" -eq "$2" ]; then
        echo "ok    $1"
    else
        echo "FAIL  $1 (exit $rc, wanted $2)"
        fail=$((fail + 1))
    fi
}

say "naming a port = none entry says so" \
    "is not on the bench" "$tc -D $dl connect B1"

# The manual is a file beside the code, reached only through --man, so
# nothing else in the program would notice if it stopped being found.
# The tail is checked rather than the head: a truncated read still
# prints a plausible-looking banner.
say "--man prints the manual"  "TRAPS"       "$tc --man"
say "--man reaches the end"    "guards writes to the hub, not reads" \
    "$tc --man"
status "--man exits 0"         0             "$tc --man"

# An empty device selection.
#
# exsys reads "no ports named" as "every port", so an empty splat is
# indistinguishable from a deliberate hub.off(). A devlist whose every
# entry says 'port = none' selects nothing, and each_device carried that
# nothing into the hub: --method serial powered all sixteen ports UP and
# then reported success for the nought boards it flashed, and --method
# power powered the whole bench DOWN, looped over nothing and left it
# off. It is refused at selection now, before the hub is touched.
#
# Only the default method (serial) is exercised here: reproducing the
# --method power case on a live bench would mean cutting it.
ssh -o BatchMode=yes "root@$host" \
    "sed 's/^  port        = [0-9][0-9]*/  port        = none/' $dl > /tmp/t-none.conf"
say "an empty device selection is refused" \
    "no device selected" "$tc -D /tmp/t-none.conf flash /tmp/tribe-test-no-such.hex"
status "and it exits 1" 1 "$tc -D /tmp/t-none.conf flash /tmp/tribe-test-no-such.hex"
# The positive control: the same command on the real devlist gets past
# selection and fails later, on the missing firmware, not on selection.
say "a real devlist still selects its boards" \
    "Devices :" "$tc -D $dl flash /tmp/tribe-test-no-such.hex DB"

# The openocd gate.
#
# Every command that reaches a board shells out to openocd, and until
# 2026-09-17 a missing or mistyped one was Errno::ENOENT out of Open3 --
# once per board, from inside the thread pool, after the ports had been
# powered up and the warm-up slept through. flash and reset now check
# for it before switching anything. Nothing here touches the hub: the
# check happens before the first command is sent.
say "a missing openocd is named, not ENOENT" \
    "openocd not found at '/tmp/no-such-openocd'" \
    "$tc -D $dl --openocd=/tmp/no-such-openocd reset DB"
status "and it exits 1" 1 "$tc -D $dl --openocd=/tmp/no-such-openocd reset DB"
# The positive control: the real one is still found, or the test above
# would pass on a tool that rejected every path.
status "the real openocd is accepted" 0 "$tc -D $dl --openocd=openocd usb status"

# --require, which is how a tally reaches the tool.
#
# A devlist naming a tally that nothing registered is an error rather
# than a silent fall back to counting lines: a capture that reported
# line counts would read exactly like a bench that had gone quiet.
say "a missing --require file is refused" \
    "no such file to require" \
    "$tc -D $dl -r /tmp/no-such-tally.rb usb status"
ssh -o BatchMode=yes "root@$host" \
    "printf 'class T\n def initialize(d); @n = 0; end\n def <<(l); @n += 1; self; end\n def summary; %s; end\nend\nTribeControl::Tally.register(:test) {|d| T.new(d) }\n' \\
     '\"seen=#{@n}\"' > /tmp/t-tally.rb"
status "a --require'd file loads" 0 "$tc -D $dl -r /tmp/t-tally.rb usb status"

# The exit status of flash and reset.
#
# Both fold over what each_device returns, and each_device used to run
# its jobs with Parallel.map's default in_processes: the children pushed
# their results into their own copy of the parent's accumulator, so the
# fold saw [], [].all? is true, and the command exited 0 however many
# boards had failed.  reset was affected from the day it was written and
# flash from the day serial became its default.  Nothing here touches a
# board: the firmware does not exist, and the bogus serial means openocd
# never finds an adapter to talk to.
status "flash exits 1 when the firmware is missing" 1 \
       "$tc -D $dl flash /tmp/tribe-test-no-such.hex DB"
ssh -o BatchMode=yes "root@$host" \
    "sed 's/000760103710/000000000000/' $dl > /tmp/t-badserial.conf"
status "reset exits 1 when the probe cannot be found" 1 \
       "$tc -D /tmp/t-badserial.conf reset DB"
# The positive control.  Without it the two tests above would pass on a
# tool that returned 1 for everything.  It is the one test here that acts
# on a board: it reboots D4 over SWD, which is what reset is for and what
# the bench does to it before every run anyway.
status "reset exits 0 on a board it can reach" 0 \
       "$tc -D $dl reset D4"

# A declared port with no board on it.
#
# usb_to_tty returns nil there.  That nil used to be carried into a
# reader thread that died in UART.open with nothing joining it, so the
# run went its full duration and reported ok=0, tx-rate=NaN, which reads
# as "the board is up and saying nothing" -- the one thing connect exists
# to answer.  Port 11 is declared by nothing and has no board.
ssh -o BatchMode=yes "root@$host" \
    "printf 'X9 {\\n  interface = jlink\\n  baud = 115200\\n  port = 11\\n}\\n' | cat $dl - > /tmp/t-empty.conf"
say "a port with no board is reported, not captured silently" \
    "no console enumerated" "$tc -D /tmp/t-empty.conf connect --duration 1 X9"

# The power-cycle gate, which is the one test here that writes flash.
#
# Opt-in, because it does: TRIBE_TEST_FLASH=1 sh test-tribe-control
#
# It cannot be done any other way.  The warning it checks for fires only
# after a SUCCESSFUL flash, so there has to be one.  What keeps it safe is
# where it writes: the last 4 KB page, which the test refuses to touch
# unless it is already erased, and erases again afterwards.  No firmware
# is overwritten.
#
# What it is for: the post-flash power cycle used to call @exsys.off()
# with a raw port and no gate, so a board declared on a reserved port had
# its VBUS cut for two seconds after every flash, with no --force and no
# way to say no.  Ports 12-15 feed the Raspberry Pis.
ocd () {  # ocd <serial> <command>
    ssh -o BatchMode=yes "root@$host" "openocd -c 'set WORKAREASIZE 0x4000' -c 'source [find interface/jlink.cfg]' -c 'transport select swd' -c 'source [find target/nrf52.cfg]' -c 'adapter serial $1' -c init -c 'reset halt' -c '$2' -c 'reset run' -c shutdown 2>&1"
}

if [ -n "${TRIBE_TEST_FLASH:-}" ]; then
    dbserial=000760103710                 # DB, hub port 8
    page=0x0007f000                       # its last page

    if ! ocd "$dbserial" "mdw $page 1" | grep -q "$page: ffffffff"; then
        echo "FAIL  power-cycle gate: DB's last page is not erased, refusing to write"
        fail=$((fail + 1))
    else
        ssh -o BatchMode=yes "root@$host" \
            "printf ':020000040007F3\\n:04F00000DEADBEEFD4\\n:00000001FF\\n' > /tmp/t-marker.hex
             sed 's/^reserved   = \\[ 12,/reserved   = [ 8, 12,/' $dl > /tmp/t-res8.conf"

        # devnum, not 'usb status'.  A power CYCLE ends with the port on,
        # so a status check afterwards passes whether or not the port was
        # cut -- it cannot fail, which makes it no test at all.  The
        # kernel bumps devnum every time a device enumerates, so an
        # unchanged devnum is proof the board never lost power and a
        # changed one is proof it did.
        dbpath=/sys/bus/usb/devices/1-1.2.2.4          # DB, hub port 8
        before=$(ssh -o BatchMode=yes "root@$host" "cat $dbpath/devnum")

        say "a reserved port is not cut after a flash" \
            "NOT power-cycling" "$tc -D /tmp/t-res8.conf flash /tmp/t-marker.hex DB"
        after=$(ssh -o BatchMode=yes "root@$host" "cat $dbpath/devnum")
        if [ "$before" = "$after" ]; then
            echo "ok    and the board never lost power (devnum $after)"
        else
            echo "FAIL  the reserved port WAS cut (devnum $before -> $after)"
            fail=$((fail + 1))
        fi

        say "an unreserved port still gets its cycle" \
            "power-cycling after flash" "$tc -D $dl flash /tmp/t-marker.hex DB"
        cycled=$(ssh -o BatchMode=yes "root@$host" "cat $dbpath/devnum")
        if [ "$after" != "$cycled" ]; then
            echo "ok    and that board did lose power (devnum $after -> $cycled)"
        else
            echo "FAIL  the unreserved port was NOT cycled (devnum unchanged)"
            fail=$((fail + 1))
        fi

        ocd "$dbserial" "flash erase_address $page 0x1000" > /dev/null
        if ocd "$dbserial" "mdw $page 1" | grep -q "$page: ffffffff"; then
            echo "ok    DB restored to erased"
        else
            echo "FAIL  DB NOT restored -- its last page still holds the marker"
            fail=$((fail + 1))
        fi
        ssh -o BatchMode=yes "root@$host" 'rm -f /tmp/t-marker.hex'
    fi
else
    echo "skip  power-cycle gate (TRIBE_TEST_FLASH=1 to run it; it writes flash)"
fi

ssh -o BatchMode=yes "root@$host" 'rm -f /tmp/t-*.conf /tmp/t-tally.rb'
[ "$fail" -eq 0 ] && echo "all tribe-control tests passed" || { echo "$fail failed"; exit 1; }
